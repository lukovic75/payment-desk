{
  "name": "payment-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A team of concurrent Mozaik agents that turns supplier invoices into reviewed SEPA payment drafts, with a human approving anything above policy.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "demo": "npm run build && npm run dev:scripted",
    "cli": "tsx server/cli.ts",
    "lab": "tsx server/lab/cli.ts",
    "lab:live": "tsx server/lab/cli.ts --live",
    "lab:benchmark": "tsx server/lab/cli.ts --benchmark",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test server/test/*.test.ts",
    "dev:scripted": "DESK_SCRIPTED=1 DESK_PERSIST=off MOZAIK_CREDENTIALS_FILE=/nonexistent API_PORT=8799 tsx server/index.ts",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mozaik-ai/core": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^18.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
