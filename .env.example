# One model provider key is required. Mozaik picks the provider from the model name.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the models (defaults below). Any name Mozaik supports works, e.g. gpt-5.5
# FAST_MODEL=claude-haiku-4-5        # Extractor, Validator, Policy
# CAREFUL_MODEL=claude-sonnet-5-5    # Auditor, Investigator

# Alternative with no key and no cost: models on this machine, through an OpenAI-compatible local server such as Ollama.
# Nothing is sent to a cloud provider in this mode, and nothing stands in for the local server if it is not running.
# A small local model is slower and less capable than a hosted one; see README, "Local inference".
# DESK_INFERENCE=local
# LOCAL_MODEL=qwen2.5:7b-instruct-12k                              # one model for every agent, or set the two below
# LOCAL_FAST_MODEL=                                  # Extractor, Validator, Policy
# LOCAL_CAREFUL_MODEL=                               # Auditor, Investigator
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1     # must be a localhost address
# LOCAL_MAX_CONCURRENCY=1                            # model requests at a time (agent loops still overlap)
# LOCAL_TOOL_PROTOCOL=json                           # json: schema-constrained tool calls (default); native: the server's own tool calls
# LOCAL_SCHEMA_LIMITS=on                              # on: list limits are enforced by the model server's schema (default); off: the earlier form

# Optional: Mozaik Cloud live trace. `npx @mozaik-ai/cloud-sdk pair` or set MOZAIK_API_KEY=pk_...
# MOZAIK_API_KEY=

# Optional: API server port (default 8787), per-loop timeout, where case state is saved
# API_PORT=8787
# AGENT_TIMEOUT_MS=90000
# DESK_STATE_FILE=.desk-state.json
# DESK_PERSIST=off

# Optional: where Financial Stress Lab results are saved, or LAB_PERSIST=off to keep them in memory only
# LAB_RESULTS_FILE=.lab-results.json
# LAB_PERSIST=off
