# One model provider key is required. Mozaik picks the provider from the model name.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the models (defaults below). Any name Mozaik supports works, e.g. gpt-5.5
# FAST_MODEL=claude-haiku-4-5
# CAREFUL_MODEL=claude-sonnet-5-5

# Optional: Mozaik Cloud live trace. `npx @mozaik-ai/cloud-sdk pair` or set MOZAIK_API_KEY=pk_...
# MOZAIK_API_KEY=

# Optional: API server port (default 8787)
# API_PORT=8787
